<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x86;x64;ARM64</Platforms>
    <DebugType>none</DebugType>
    <DefaultCompressionLevel>high</DefaultCompressionLevel>
    <SuppressValidation>false</SuppressValidation>
    <!--
      ICE38/43/57 classify the shell folders as per-user without evaluating the
      package's forced ALLUSERS=1 context. These components deliberately use
      HKLM key paths because ProgramMenuFolder and DesktopFolder resolve to the
      shared shell folders for this per-machine package. ICE61 is the
      intentional same-version upgrade. scripts/Test-MsiPackage.ps1 asserts all
      of these invariants explicitly.
    -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE61</SuppressIces>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <Cultures>en-US</Cultures>
    <OutputName Condition="'$(OutputName)' == ''">WireSockUI-$(ProductVersion)-win-$(InstallerPlatform)-$(ProductFlavor)</OutputName>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);ProductCode=$(ProductCode);ProductFlavor=$(ProductFlavor);ProductArchitecture=$(ProductArchitecture);SecurityComponentGuid=$(SecurityComponentGuid);ShortcutComponentGuid=$(ShortcutComponentGuid);DesktopShortcutComponentGuid=$(DesktopShortcutComponentGuid);RuntimeHostComponentGuid=$(RuntimeHostComponentGuid);FileComponentGuidSeed=$(FileComponentGuidSeed);PayloadAuthoringPath=$(PayloadAuthoringPath)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(InstallerPlatform)' == '' and '$(Platform)' == 'x86'">
    <InstallerPlatform>x86</InstallerPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InstallerPlatform)' == '' and '$(Platform)' == 'x64'">
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InstallerPlatform)' == '' and '$(Platform)' == 'ARM64'">
    <InstallerPlatform>arm64</InstallerPlatform>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadDirectory)' != ''">
    <BindPath Include="$(PayloadDirectory)">
      <BindName>Payload</BindName>
    </BindPath>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="ValidateInstallerInputs" BeforeTargets="Build">
    <ItemGroup Condition="'$(PayloadDirectory)' != ''">
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\_manifest\**\*" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.pdb" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.wixpdb" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.msi" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.msix" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.msp" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.cab" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.zip" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.nupkg" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.snupkg" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.sha256" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.obj" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.res" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.exp" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.lib" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.ilk" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.map" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.spdx.json" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.sbom.json" />
      <_ForbiddenPayloadMetadata Include="$(PayloadDirectory)\**\*.intoto.jsonl" />
    </ItemGroup>

    <Error Condition="'$(PayloadDirectory)' == ''"
           Text="PayloadDirectory must identify a filtered, architecture-specific published payload." />
    <Error Condition="'$(PayloadAuthoringPath)' == '' or !Exists('$(PayloadAuthoringPath)')"
           Text="PayloadAuthoringPath must identify manifest-derived WiX include authoring generated by scripts/Build-Msi.ps1." />
    <Error Condition="'$(ProductVersion)' == ''"
           Text="ProductVersion must be a three-part Windows Installer version." />
    <Error Condition="'$(ProductCode)' == ''"
           Text="ProductCode must be supplied by scripts/Build-Msi.ps1." />
    <Error Condition="'$(RuntimePayloadValidated)' != 'true'"
           Text="The supported build entry point is scripts/Build-Msi.ps1, which validates the embedded runtime manifest before invoking WiX." />
    <Error Condition="'$(ProductFlavor)' != 'uwp' and '$(ProductFlavor)' != 'no-uwp'"
           Text="ProductFlavor must be uwp or no-uwp." />
    <Error Condition="'$(ProductArchitecture)' != 'x86' and '$(ProductArchitecture)' != 'x64' and '$(ProductArchitecture)' != 'arm64'"
           Text="ProductArchitecture must be x86, x64, or arm64." />
    <Error Condition="'$(SecurityComponentGuid)' == '' or '$(ShortcutComponentGuid)' == '' or '$(DesktopShortcutComponentGuid)' == '' or '$(RuntimeHostComponentGuid)' == '' or '$(FileComponentGuidSeed)' == ''"
           Text="Architecture-specific component GUIDs and file-component seed must be supplied by scripts/Build-Msi.ps1." />
    <Error Condition="'$(InstallerPlatform)' != 'x86' and '$(InstallerPlatform)' != 'x64' and '$(InstallerPlatform)' != 'arm64'"
           Text="InstallerPlatform must be x86, x64, or arm64." />
    <Error Condition="'$(PayloadDirectory)' != '' and !Exists('$(PayloadDirectory)\WireSockUI.exe')"
           Text="The payload does not contain the native WireSockUI.exe launcher." />
    <Error Condition="'$(PayloadDirectory)' != '' and !Exists('$(PayloadDirectory)\WireSockUI.exe.config')"
           Text="The payload does not contain WireSockUI.exe.config." />
    <Error Condition="'$(PayloadDirectory)' != '' and !Exists('$(PayloadDirectory)\WireSockUI.Managed.dll')"
           Text="The payload does not contain WireSockUI.Managed.dll." />
    <Error Condition="'@(_ForbiddenPayloadMetadata)' != ''"
           Text="PayloadDirectory must be pre-filtered and cannot contain compiler intermediates, PDB, installer, archive, checksum, SBOM, provenance, or _manifest staging files." />
  </Target>
</Project>
